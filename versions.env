# Pinned upstream versions. Bump one at a time and re-run the security suite.
# SHAs recorded on 2026-11-19 from the release tags (see docs/SECURITY-VET.md).
OPENSHELL_VERSION=v0.1.9            # tag sha ce58cf8e9b953281352d98a637e41616295b1318
OPENSHELL_CHART_VERSION=0.1.9       # oci://ghcr.io/nvidia/openshell/helm-chart
AGENT_SANDBOX_VERSION=v1.0.3        # kubernetes-sigs/agent-sandbox, same pin OpenShell's own k8s e2e uses
CALICO_VERSION=v3.30.3              # policy-enforcing CNI for kind, same pin as OpenShell's CI
# Anonymous OpenShell telemetry is ON by default upstream. We always turn it off.
OPENSHELL_TELEMETRY_ENABLED=false
